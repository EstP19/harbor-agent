AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Clave API de Gemini (Prioritaria si está presente)
GEMINI_API_KEY=AIzaSy_tu_clave_gemini_aqui
GEMINI_MODEL=gemini-3.1-flash-lite

# Clave API de OpenAI (Fallback automático)
OPENAI_API_KEY=sk-proj-tu_clave_aqui

# Vercel AI Gateway Key (Opcional)
AI_GATEWAY_API_KEY=

# Conexión a PostgreSQL (Esquemas agent_core y agent_vector)
DATABASE_URL=postgresql://agent_api:replace-me@localhost:5432/harbor_db

# Bearer token required for Health capability requests
HARBOR_HEALTH_SERVICE_TOKEN=

# Optional local ChatGPT plan integration. Use the same values in Developer.
# HOST=127.0.0.1
# HARBOR_CHATGPT_LOCAL_ORIGIN=http://127.0.0.1:3010
# HARBOR_DEVELOPER_SERVICE_TOKEN=

# Optional Dokploy mode. State is encrypted in PostgreSQL migration 180.
# HARBOR_CHATGPT_PUBLIC_ORIGIN=https://developer.myharborliving.com
# HARBOR_CHATGPT_AGENT_HOST=harbor-agent:2000
# HARBOR_CHATGPT_STATE_KEY=
# HARBOR_CHATGPT_CLIENT_ID=
# HARBOR_CHATGPT_CLIENT_AUTH_METHOD=
# HARBOR_CHATGPT_CLIENT_SECRET=
# HARBOR_CHATGPT_PLAN_SCOPES=

# Open-source self-hosted VM: authorize locally, then import the encrypted session.
# HARBOR_CHATGPT_MODE=self-hosted
# HARBOR_CHATGPT_OWNER_ID=your-developer-iam-user-uuid
# HARBOR_CHATGPT_MODEL=gpt-6-luna
# HARBOR_CHATGPT_REASONING_EFFORT=high
